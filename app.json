{
  "expo": {
    "name": "Lughly",
    "slug": "lughly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "lughly",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lughly.app",
      "infoPlist": {
        "NSAllowsArbitraryLoads": false,
        "NSCameraUsageDescription": "Lughly necesita acceso a la cámara para tomar fotos de trabajos y documentos.",
        "NSPhotoLibraryUsageDescription": "Lughly necesita acceso a tus fotos para adjuntar imágenes de trabajos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/images/android-icon-foreground.png",
        "backgroundColor": "#04070f"
      },
      "package": "com.lughly.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./src/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#04070f"
        }
      ],
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para encontrar profesionales cerca de ti y calcular su tiempo de llegada.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d4bfcd1b-8f1c-4edc-b60f-f3f0b9820e93"
      }
    }
  }
}
